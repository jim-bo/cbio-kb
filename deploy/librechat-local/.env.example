# LibreChat secrets for the local stack. Copy to .env (gitignored) with fresh
# values, from the repo root:
#
#   printf 'CREDS_KEY=%s\nCREDS_IV=%s\nJWT_SECRET=%s\nJWT_REFRESH_SECRET=%s\n' \
#     "$(openssl rand -hex 32)" "$(openssl rand -hex 16)" \
#     "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" > deploy/librechat-local/.env
#
# CREDS_KEY (64 hex) and CREDS_IV (32 hex) encrypt stored credentials; the JWT
# secrets sign logins, so changing them signs everyone out.
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
